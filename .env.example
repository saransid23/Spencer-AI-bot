# Environment Configuration for Spencer AI
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Ollama Local LLM Configuration (Default: Llama 3.1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# PostgreSQL Async Database Connection
DATABASE_URL=postgresql+asyncpg://spencer_user:CHANGE_ME@localhost:5432/spencer_db

# Database Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Chat Context Window Limit (Number of recent messages passed to model)
CHAT_CONTEXT_LIMIT=20

# Optional: Voice Transcription (Whisper API)
# Not required for ordinary text chat with Ollama.
OPENAI_API_KEY=
